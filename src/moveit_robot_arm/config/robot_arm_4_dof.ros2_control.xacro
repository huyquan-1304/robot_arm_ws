<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="robot_arm_4_dof_ros2_control" params="name initial_positions_file">

    <xacro:property name="initial_positions"
      value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

    <xacro:macro name="mock_joint" params="joint">
      <joint name="${joint}">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions[joint]}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>
      <xacro:mock_joint joint="JOINT_1"/>
      <xacro:mock_joint joint="JOINT_2"/>
      <xacro:mock_joint joint="JOINT_3"/>
      <xacro:mock_joint joint="JOINT_4"/>
      <xacro:mock_joint joint="GRIPPER_JOINT"/>
    </ros2_control>

  </xacro:macro>

</robot>