Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 0.5
      Plane Cell Count: 20
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 239; 41; 41
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 30
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 255; 25; 0
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.04
        Head Radius: 0.025
      Value: true
    # Vi tri that trong Gazebo (chi co o che do drive_mode:=control). Lech voi mui ten do = sai so odometry
    - Class: rviz_default_plugins/Odometry
      Name: GroundTruth
      Enabled: true
      Topic:
        Value: /ground_truth/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 30
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 0; 200; 0
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.04
        Head Radius: 0.025
      Value: true
    # Ket qua EKF (chi co khi use_ekf:=true)
    - Class: rviz_default_plugins/Odometry
      Name: EKF
      Enabled: true
      Topic:
        Value: /odometry/filtered
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 30
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 30; 120; 255
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.04
        Head Radius: 0.025
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0.1
      Pitch: 0.55
      Yaw: 3.9
      Target Frame: base_footprint
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
